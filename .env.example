# Copy to .env and fill in. Never commit .env.

# --- Database (used by the db container and to build DATABASE_URL in compose.yaml)
POSTGRES_USER=sabq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sabq
# Only needed when running the backend outside Docker (e.g. `uv run pytest` against the dev db):
# DATABASE_URL=postgresql+psycopg://sabq:change-me@localhost:5440/sabq

# --- Development ports on the host (compose.override.yaml); change if already in use
# SABQ_DB_PORT=5440
# SABQ_APP_PORT=8010
# SABQ_MAILPIT_PORT=8025

# --- General
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost
# Domain in production (Caddy gets HTTPS automatically), ":80" locally
SITE_ADDRESS=:80
# Image tag to run in production (set by the deploy step); local builds use sabq-backend:local
# SABQ_IMAGE=ghcr.io/medalibenm/sabq-backend:<git-sha>

# --- Bot identity: User-Agent is "SabqBot/<version>" plus " (+URL)" when set. Required before production.
SABQBOT_CONTACT_URL=

# --- Egress proxy for geo-blocked .dz sources (empty = not used)
DZ_PROXY_URL=

# --- Story-matching embeddings via OpenRouter
OPENROUTER_API_KEY=
EMBEDDING_MODEL=voyageai/voyage-4
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

# --- Email (MailerSend SMTP in production; Mailpit in development)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Sabq <no-reply@localhost>
