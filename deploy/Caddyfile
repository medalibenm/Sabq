# SITE_ADDRESS is ":80" locally (plain HTTP) and the domain in production (automatic HTTPS).
{$SITE_ADDRESS}

# Live updates (Server-Sent Events): no compression, flushed at once, or events would wait in
# buffers (decision 2026-10-21).
@stream path /app/stream
handle @stream {
	reverse_proxy app:8000 {
		flush_interval -1
	}
}

# The API and the Sabq team pages.
@backend path /auth/* /app/* /admin/* /api/* /health /health.json /health/* /docs /docs/* /redoc /openapi.json /ui
handle @backend {
	encode gzip
	reverse_proxy app:8000
}

# Everything else is the web app: its files, or index.html for its own routes.
handle {
	root * /srv/www
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; img-src https: http: data:; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
